        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;table style='font-size:11px'&gt;&lt;tr&gt;&lt;td&gt;&lt;span style='color:#6c8ebf'&gt;&amp;#9632;&lt;/span&gt; LLM agent (model calls)&lt;br&gt;&lt;span style='color:#82b366'&gt;&amp;#9632;&lt;/span&gt; Plain Python, no model&lt;br&gt;&lt;span style='color:#d79b00'&gt;&amp;#9632;&lt;/span&gt; MCP server&lt;br&gt;&lt;span style='color:#d6b656'&gt;&amp;#9632;&lt;/span&gt; Skill (skills/, task 1.5)&lt;/td&gt;&lt;td style='padding-left:24px'&gt;&lt;span style='color:#666666'&gt;&amp;#9632;&lt;/span&gt; UI / storage&lt;br&gt;Dashed box: planned, not built yet&lt;br&gt;Two-headed arrow: task down, report up&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="960" width="540" height="110" as="geometry" />
        </mxCell>
