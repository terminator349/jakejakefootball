      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Front Office: how the agents interact&lt;br&gt;&lt;span style='font-size:12px;font-weight:normal'&gt;As built through task 2.3 (Nov 19, 2026), branch w5-gm-team. Every agent runs DeepSeek V4.1 Flash through OpenRouter.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1">
